        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "signature_envelope": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "owner_recertified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "signature_envelope": {
            "$ref": "#/$defs/signature_envelope"
          }
        }
      }
