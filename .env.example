# SteerBench-Work runner: environment variables.
# Copy to .env (or .env.local) and fill in the values you need.

# Recommended path: one key, one endpoint, every provider.
# https://vercel.com/docs/ai-gateway
#
# Models are addressed as "provider/model-name". Examples:
#   openai/gpt-5.5
#   openai/gpt-5.5-mini
#   anthropic/claude-opus-4-7
#   anthropic/claude-sonnet-4-7
#   together/qwen3-235b-thinking
#
# The runner reads AI_GATEWAY_API_KEY first, then falls back to OPENAI_API_KEY
# so existing single-provider setups keep working without changes.
AI_GATEWAY_API_KEY=

# Legacy: direct OpenAI key. Still honored by the openai-nano-demo command
# and as a fallback for the AI Gateway adapter when AI_GATEWAY_API_KEY is unset.
OPENAI_API_KEY=

# Optional: pin a specific model id for the legacy openai-nano-demo path.
# Ignored by run-gateway and run-grid (those take --model on the CLI).
# OPENAI_NANO_MODEL=gpt-5.4-nano
# OPENAI_MODEL=gpt-5.4-nano

